    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": {
                "foreground": "#939ab7"
            }
        },

        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": {
                "foreground": "#a6da95"
            }
        },
        {
            "scope": "constant.character.escape",
            "settings": {
                "foreground": "#f5bde6"
            }
        },
        {
            "scope": "string.regexp",
            "settings": {
                "foreground": "#f5a97f"
            }
        },
        {
            "scope": [
                "punctuation.definition.escape",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#f0c6c6"
            }
        },
        {
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#f5a97f"
            }
        },
        {
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": {
                "foreground": "#f5a97f"
            }
        },
        {
            "scope": "keyword.other.unit",
            "settings": {
                "foreground": "#df7c4f"
            }
        },
        {
            "scope": "constant",
            "settings": {
                "foreground": "#f5a97f"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.directive",
                "storage",
                "storage.type",
                "support.type"
            ],
            "settings": {
                "foreground": "#c6a0f6"
            }
        },
        {
            "scope": ["punctuation.definition.directive", "storage.modifier"],
            "settings": {
                "foreground": "#b787ce"
            }
        },
        {
            "scope": ["keyword.operator", "keyword.operator.word"],
            "settings": {
                "foreground": "#91d7e3"
            }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": {
                "foreground": "#8aadf4"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "support.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#f5a97f"
            }
        },
        {
            "scope": [
                "meta.type.declaration",
                "meta.type.annotation",
                "entity.name.type"
            ],
            "settings": {
                "foreground": "#eed49f"
            }
        },
        {
            "scope": [
                "entity.name.type.enum",
                "meta.head.enum",
                "entity.name.namespace"
            ],
            "settings": {
                "foreground": "#8bd5ca"
            }
        },
        {
            "scope": [
                "entity.name.constant",
                "constant.langauge",
                "constant.other"
            ],
            "settings": {
                "foreground": "#ed8796"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#cad3f5"
            }
        },
        {
            "scope": [
                "variable.language.special",
                "variable.parameter.function.language.special"
            ],
            "settings": {
                "foreground": "#ed8796"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "support.type.property-name",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#8aadf4"
            }
        },
        {
            "scope": ["label", "entity.name.label"],
            "settings": {
                "foreground": "#7dc4e4"
            }
        },
        {
            "scope": "punctuation",
            "settings": {
                "foreground": "#939ab7"
            }
        },
        {
            "scope": "punctuation.other.special",
            "settings": {
                "foreground": "#f5bde6"
            }
        },
        {
            "scope": "markup.list",
            "settings": {
                "foreground": "#939ab7"
            }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": {
                "foreground": "#8aadf4"
            }
        }
    ]
}
