{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./build",

        "module": "nodenext",
        "target": "esnext",
        "lib": ["ESNext"],
        "types": ["node"],

        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        "noUncheckedIndexedAccess": true,

        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/tests/**", "src/docgen/**", "docs/**"],
}
